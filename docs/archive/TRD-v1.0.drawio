    <diagram id="spymonk-redact-trd-2" name="02  Sanitization pipeline">
        <mxGraphModel dx="1368" dy="1111" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1040" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=28;align=center;verticalAlign=middle;spacing=14;fontStyle=1;fillColor=none;strokeColor=none;align=left;spacing=0;" value="SPYMONK REDACT  /  02  Sanitization pipeline" vertex="1">
                    <mxGeometry height="48" width="1320" x="40" y="25" as="geometry"/>
                </mxCell>
                <mxCell id="sub" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;spacing=14;fillColor=none;strokeColor=none;align=left;spacing=0;" value="Both cores scan original text and replace each final region exactly once." vertex="1">
                    <mxGeometry height="35" width="1320" x="40" y="79" as="geometry"/>
                </mxCell>
                <mxCell id="foot" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;spacing=14;fillColor=none;strokeColor=none;align=left;spacing=0;" value="TRD v1.0  |  16 October 2026  |  Design only  |  TRD sections 5-7" vertex="1">
                    <mxGeometry height="30" width="1320" x="40" y="1000" as="geometry"/>
                </mxCell>
                <mxCell id="validate" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DBEAFE;strokeColor=#60A5FA;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;spacing=14;" value="1  VALIDATE COMPLETE INPUT&#xa;Adapter byte ceiling; strict text&#xa;Reject invalid UTF-8 / NUL / surrogates&#xa;Remove one leading BOM" vertex="1">
                    <mxGeometry height="130" width="380" x="50" y="155" as="geometry"/>
                </mxCell>
                <mxCell id="structure" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DBEAFE;strokeColor=#60A5FA;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;spacing=14;" value="2  SCAN LINE STRUCTURE&#xa;Preserve CRLF / LF / CR&#xa;Identify URL authority regions&#xa;Keep original source offsets" vertex="1">
                    <mxGeometry height="130" width="380" x="510" y="155" as="geometry"/>
                </mxCell>
                <mxCell id="detect" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F3E8FF;strokeColor=#C084FC;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;spacing=14;" value="3  COLLECT RULE CANDIDATES&#xa;Core secret and path rules always on&#xa;Email on; private IP optional&#xa;Line-bounded, deterministic scans" vertex="1">
                    <mxGeometry height="130" width="380" x="970" y="155" as="geometry"/>
                </mxCell>
                <mxCell id="error" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FEE2E2;strokeColor=#F87171;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;spacing=14;" value="INVALID INPUT&#xa;Fixed error; no raw-text fallback" vertex="1">
                    <mxGeometry height="65" width="380" x="50" y="315" as="geometry"/>
                </mxCell>
                <mxCell id="filter" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F3E8FF;strokeColor=#C084FC;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;spacing=14;" value="4  CHECK RESERVED TOKENS&#xa;Ignore complete existing placeholders&#xa;No exemption for a larger value&#xa;Validate nonempty candidate ranges" vertex="1">
                    <mxGeometry height="130" width="380" x="970" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="merge" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FEF3C7;strokeColor=#FBBF24;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;spacing=14;" value="5  RESOLVE OVERLAPS&#xa;Sort and group strict overlaps&#xa;Identical spans: rule precedence&#xa;Different spans: redact whole union" vertex="1">
                    <mxGeometry height="130" width="380" x="510" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="emit" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DCFCE7;strokeColor=#4ADE80;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;spacing=14;" value="6  EMIT ONCE, LEFT TO RIGHT&#xa;Keep untouched text and separators&#xa;Use stable replacement tokens&#xa;Count final regions, not detections" vertex="1">
                    <mxGeometry height="130" width="380" x="50" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="result" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DCFCE7;strokeColor=#4ADE80;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;spacing=14;" value="7  RETURN COMPLETE RESULT&#xa;Sanitized text + aggregate counts&#xa;Line count + resolved options&#xa;Rule version + optional output ranges" vertex="1">
                    <mxGeometry height="150" width="380" x="50" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="example" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="OVERLAP EXAMPLE&#xa;password=alex@example.com&#xa;becomes password=[REDACTED]&#xa;One SR-001 replacement, not two." vertex="1">
                    <mxGeometry height="150" width="380" x="510" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="invariant" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="INVARIANTS&#xa;Deterministic and idempotent&#xa;No source-value report fields&#xa;No partial successful results&#xa;No silent truncation" vertex="1">
                    <mxGeometry height="150" width="380" x="970" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="limit" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=14;fillColor=none;strokeColor=none;align=left;spacing=0;" value="Limits: CLI 5,242,880 bytes  /  Browser 102,400 bytes&#xa;A second run with the same options makes zero new replacements for supported formats." vertex="1">
                    <mxGeometry height="55" width="1160" x="120" y="910" as="geometry"/>
                </mxCell>
                <mxCell id="e1" edge="1" parent="1" source="validate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=1.5;fontColor=#475569;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="structure" value="valid">

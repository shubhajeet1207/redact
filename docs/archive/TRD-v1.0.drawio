                    <mxGeometry height="210" width="400" x="50" y="145" as="geometry"/>
                </mxCell>
                <mxCell id="result" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DCFCE7;strokeColor=#4ADE80;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="CORE RESULT&#xa;sanitizedText; replacements; linesScanned; resolved options; ruleVersion&#xa;countsByRule includes every rule ID, including zero counts.&#xa;Optional findings: outputStart, outputEnd, ruleId.&#xa;Ranges are half-open Unicode code-point offsets into sanitized output.&#xa;No original-value, context, input-path, or reversible-map metadata." vertex="1">
                    <mxGeometry height="210" width="850" x="500" y="145" as="geometry"/>
                </mxCell>
                <mxCell id="r1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F3E8FF;strokeColor=#C084FC;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="SR-001  /  ALWAYS ON&#xa;Recognized secret assignments&#xa;password, token, api_key, etc.&#xa;[REDACTED]&#xa;Keep keys, quotes and delimiters." vertex="1">
                    <mxGeometry height="170" width="400" x="50" y="425" as="geometry"/>
                </mxCell>
                <mxCell id="r2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F3E8FF;strokeColor=#C084FC;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="SR-002  /  ALWAYS ON&#xa;Authorization and Proxy-Authorization&#xa;Basic or Bearer credential&#xa;[REDACTED]&#xa;Keep header name and scheme." vertex="1">
                    <mxGeometry height="170" width="400" x="500" y="425" as="geometry"/>
                </mxCell>
                <mxCell id="r3" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F3E8FF;strokeColor=#C084FC;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="SR-003  /  ALWAYS ON&#xa;Password in recognized service URLs&#xa;[REDACTED]&#xa;Keep host, port, path and username,&#xa;unless another enabled rule applies." vertex="1">
                    <mxGeometry height="170" width="400" x="950" y="425" as="geometry"/>
                </mxCell>
                <mxCell id="r4" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F3E8FF;strokeColor=#C084FC;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="SR-004  /  ALWAYS ON&#xa;Username in supported home paths&#xa;/home/&lt;user&gt;/ and C:\Users\&lt;user&gt;\&#xa;[USER]&#xa;Keep the rest of the path." vertex="1">
                    <mxGeometry height="170" width="400" x="50" y="655" as="geometry"/>
                </mxCell>
                <mxCell id="r5" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#DBEAFE;strokeColor=#60A5FA;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="SR-005  /  DEFAULT ON&#xa;Supported ASCII email patterns&#xa;[EMAIL REDACTED]&#xa;Toggle off in UI or --disable-email.&#xa;URL authority: username only." vertex="1">
                    <mxGeometry height="170" width="400" x="500" y="655" as="geometry"/>
                </mxCell>
                <mxCell id="r6" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FEF3C7;strokeColor=#FBBF24;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="SR-006  /  DEFAULT OFF&#xa;RFC1918 IPv4 only&#xa;10/8; 172.16/12; 192.168/16&#xa;[PRIVATE IP REDACTED]&#xa;Enable in UI or --enable-private-ip." vertex="1">
                    <mxGeometry height="170" width="400" x="950" y="655" as="geometry"/>

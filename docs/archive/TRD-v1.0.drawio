                </mxCell>
                <mxCell id="csp" value="PRODUCTION CONTROLS&#xa;connect-src &#39;none&#39;; local script/worker&#xa;HTTPS; safe text rendering&#xa;No injected analytics or CSP reporting" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
                    <mxGeometry x="40" y="705" width="370" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="limits" value="APPLICATION LIMITS&#xa;Clear and navigation release known state; secure memory erasure is not guaranteed.&#xa;Clipboard history, extensions, screen recording, OS dumps and already-published secrets remain outside the application&#39;s control." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">

# TRD §14.2: OCI image built FROM scratch around the static musl binary. No shell, no package
# manager, non-root user 65532. Run with a read-only root file system:
#   docker run --rm -i --read-only ghcr.io/shubhajeet1207/spymonk-redact:VERSION < app.log
# Build context: a directory holding linux-amd64/spymonk-redact and linux-arm64/spymonk-redact.
FROM scratch
ARG TARGETARCH
ARG VERSION=0.0.0
ARG REVISION=unknown
LABEL org.opencontainers.image.title="spymonk-redact" \
      org.opencontainers.image.description="Redact secrets and personal identifiers from text before sharing it." \
      org.opencontainers.image.source="https://github.com/shubhajeet1207/redact" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"
COPY --chmod=0555 linux-${TARGETARCH}/spymonk-redact /spymonk-redact
USER 65532:65532
ENTRYPOINT ["/spymonk-redact"]

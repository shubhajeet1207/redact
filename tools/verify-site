#!/usr/bin/env python3
"""Verify a deployed SpyMonk Redact site against its attested release bundle (TRD §14.6, T-10).

Usage:
  tools/verify-site URL --bundle spymonk-redact-web-X.Y.Z.tar.gz [--headers web/hosting/headers.json]

Checks, failing on the first category that does not hold:
  1. every file listed in the bundle's build-manifest.json is served with exactly that SHA-256;
  2. the served index.html references only same-origin assets (no external origin anywhere);
  3. the response headers of the page, the worker script, and a hashed asset match the policy.

Verify the bundle itself first (gh attestation verify ... --repo OWNER/redact). This tool then
proves that what the host serves is that bundle. It reads nothing but the public site.
"""

import argparse
import fnmatch
import hashlib
import json
import re
import sys
import tarfile
import urllib.error
import urllib.parse
import urllib.request


def fetch(url: str) -> tuple[bytes, dict[str, str]]:
    request = urllib.request.Request(url, headers={"User-Agent": "spymonk-redact-verify-site"})
    with urllib.request.urlopen(request, timeout=30) as response:
        return response.read(), {k.lower(): v for k, v in response.headers.items()}


def load_bundle(path: str) -> tuple[dict, dict[str, bytes]]:
    with tarfile.open(path, "r:gz") as tar:
        members = {m.name.split("/", 1)[1]: m for m in tar.getmembers() if m.isfile() and "/" in m.name}
        manifest = json.loads(tar.extractfile(members["build-manifest.json"]).read())
        files = {name: tar.extractfile(m).read() for name, m in members.items()}
    return manifest, files


def expected_headers(policy: dict, path: str) -> dict[str, str]:
    for route in policy["routes"]:
        if any(fnmatch.fnmatchcase(path, pattern) for pattern in route["match"]):
            return route["headers"]
    return {}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("url")
    parser.add_argument("--bundle", required=True)
    parser.add_argument("--headers", default="web/hosting/headers.json")
    args = parser.parse_args()
    base = args.url.rstrip("/") + "/"
    failures: list[str] = []

    manifest, files = load_bundle(args.bundle)
    for entry in manifest["files"]:
        if files.get(entry["path"]) is None or hashlib.sha256(files[entry["path"]]).hexdigest() != entry["sha256"]:
            failures.append(f"bundle is inconsistent with its own manifest: {entry['path']}")
    if failures:
        print("\n".join(failures), file=sys.stderr)
        return 1

    for entry in manifest["files"]:
        try:
            body, _ = fetch(urllib.parse.urljoin(base, entry["path"]))
        except urllib.error.URLError as e:
            failures.append(f"{entry['path']}: not served ({e})")
            continue
        if hashlib.sha256(body).hexdigest() != entry["sha256"]:
            failures.append(f"{entry['path']}: served bytes differ from the attested bundle")

    page, page_headers = fetch(base)
    html = page.decode("utf-8", "replace")
    for ref in re.findall(r'(?:src|href)="([^"]+)"', html):
        parsed = urllib.parse.urlparse(urllib.parse.urljoin(base, ref))
        same = parsed.netloc == urllib.parse.urlparse(base).netloc and parsed.scheme in ("http", "https")
        if not same and not ref.startswith("#") and not ref.startswith("https://github.com/"):
            failures.append(f"index.html references another origin: {ref}")

    with open(args.headers, encoding="utf-8") as f:
        policy = json.load(f)
    worker = next((e["path"] for e in manifest["files"] if re.fullmatch(r"assets/worker-[\w-]+\.js", e["path"])), None)
    asset = next((e["path"] for e in manifest["files"] if e["path"].startswith("assets/app-")), None)
    for path, served in [("/", page_headers)] + [
        (f"/{p}", fetch(urllib.parse.urljoin(base, p))[1]) for p in (worker, asset) if p
    ]:
        for name, value in expected_headers(policy, path).items():
            got = served.get(name.lower())
            if got != value:
                failures.append(f"{path}: header {name} is {got!r}, expected {value!r}")

    if failures:
        print("verify-site: FAILED", file=sys.stderr)
        for failure in failures:
            print(f"  {failure}", file=sys.stderr)
        return 1
    print(f"verify-site: {len(manifest['files'])} files match the bundle; headers match the policy")
    return 0


if __name__ == "__main__":
    sys.exit(main())

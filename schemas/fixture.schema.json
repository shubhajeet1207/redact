{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shubhajeet1207/redact/schemas/fixture.schema.json",
  "title": "SpyMonk Redact golden fixture file",
  "description": "Expected outputs are written and reviewed by hand; they are never generated by the engine under test (TRD §8.4). All values are synthetic.",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixtures"],
  "properties": {
    "fixtures": { "type": "array", "items": { "$ref": "#/$defs/fixture" } }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "replacements", "lines"],
      "oneOf": [
        { "required": ["input"] },
        { "required": ["inputBase64"] }
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "input": { "type": "string" },
        "inputBase64": { "type": "string", "contentEncoding": "base64" },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "email": { "type": "boolean" }, "privateIp": { "type": "boolean" } }
        },
        "maxLineBytes": { "type": "integer", "minimum": 1024, "maximum": 67108864 },
        "output": { "type": "string", "description": "Expected output; for error fixtures, the complete lines emitted before the failure." },
        "outputBase64": { "type": "string", "contentEncoding": "base64" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": { "code": { "type": "string" }, "line": { "type": "integer", "minimum": 1 } }
        },
        "replacements": { "type": "integer", "minimum": 0 },
        "byRule": {
          "type": "object",
          "propertyNames": { "pattern": "^SR-[0-9]{3}$" },
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "lines": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "hidden": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bidi": { "type": "integer" },
            "invisible": { "type": "integer" },
            "control": { "type": "integer" },
            "loneCr": { "type": "integer" }
          }
        }
      }
    }
  }
}
